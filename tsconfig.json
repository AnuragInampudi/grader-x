// tsconfig.json
{
    "compilerOptions": {
      "target": "ESNext",
      "module": "CommonJS",
      "lib": ["ESNext", "DOM"],
      "jsx": "react-jsx",
      "esModuleInterop": true,
      "allowSyntheticDefaultImports": true,
      "moduleResolution": "node",
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,
      "types": [
        "jest",
        "node",
        "@testing-library/jest-dom"
      ]
    },
    "include": ["src", "tests"],
    "exclude": ["node_modules"]
  }
  